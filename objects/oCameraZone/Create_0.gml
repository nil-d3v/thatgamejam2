zone_priority = 0;

// Bounds
override_bounds = false;

// Zoom
override_zoom = false;
zone_zoom = 2;

// Bias
override_bias = false;
zone_bias = 60;

// Follow Percent
override_follow = false;
follow_percent = 60;

// Lock Target
override_target = false;
fixed_target_x = x + sprite_width * 0.5;
fixed_target_y = y + sprite_height * 0.5;